# Fleet-Bloodhound Configuration
# Copy this file to .env and update with your values

# Fleet API Configuration
FLEET_URL=https://your-fleet-server.com

# Authentication Method 1: API Token (RECOMMENDED)
# Get your API token from Fleet: Settings → Account → API Token
FLEET_API_TOKEN=your-api-token-here

# Authentication Method 2: Email/Password (Legacy/Development)
# Only needed if not using API token
# FLEET_EMAIL=admin@example.com
# FLEET_PASSWORD=your-secure-password

# Memgraph Configuration
MEMGRAPH_URI=bolt://localhost:7687

# Optional Memgraph Bolt auth. Leave both unset for the default no-password
# Memgraph image. For production set both, or use MEMGRAPH_PASSWORD_FILE to
# read the password from a mounted secret file (Docker / Kubernetes).
# MEMGRAPH_USER=memgraph
# MEMGRAPH_PASSWORD=change-me
# MEMGRAPH_PASSWORD_FILE=/run/secrets/memgraph_password

# Web Dashboard Configuration
PORT=8080

# Web Dashboard auth.
# - WEBVIZ_API_TOKEN: when set, every /api/* call must send it via
#       Authorization: Bearer <token>     (or)
#       X-Api-Token: <token>
# - WEBVIZ_API_TOKEN_FILE: read the token from a mounted secret file.
# - WEBVIZ_REQUIRE_AUTH=true: refuse to start unless a token is configured.
# - WEBVIZ_ALLOW_ANONYMOUS_READ=true: when no token is set, allow GETs from any
#       client (default: loopback only). POST/PUT/DELETE always require a token.
#       Use only behind an authenticated reverse proxy.
# WEBVIZ_API_TOKEN=replace-with-a-long-random-string
# WEBVIZ_API_TOKEN_FILE=/run/secrets/webviz_api_token
# WEBVIZ_REQUIRE_AUTH=true
# WEBVIZ_ALLOW_ANONYMOUS_READ=false

# Optional: include backend exception text in /api error responses (debug only).
# WEBVIZ_DEBUG_ERRORS=false

# Security: Set to 'true' for self-signed Fleet certificates (development only)
# WARNING: Only use INSECURE=true in development environments
INSECURE=false

# Optional: Enable debug mode for troubleshooting
DEBUG=false


# ----------------------------------------------------------------------------
# Wikidata enrichment worker (Orient phase) — runs inside the webviz container
# ----------------------------------------------------------------------------
# Continuously categorizes uncategorized Software nodes via Wikidata SPARQL.
# Single-leader across the 4 gunicorn workers via fcntl flock.

ENRICHER_ENABLED=true
ENRICHER_INTERVAL_SEC=300
ENRICHER_BATCH_SIZE=25

# ----------------------------------------------------------------------------
# OODA supervisor (autonomous Observe → Orient → Decide → Act)
# ----------------------------------------------------------------------------
# When OODA_ENABLED=true the webviz container drives the full ETL on a timer:
#   Observe — pull host/user delta from Fleet
#   Orient  — kick the Wikidata enricher
#   Decide  — compute Shadow IT outliers + totals, persist findings
#   Act     — append a one-line audit entry per cycle
# Reuses FLEET_URL / FLEET_API_TOKEN / MEMGRAPH_* from this file.
#
# Endpoints:
#   GET  /api/ooda/status     supervisor state + last cycle summary
#   GET  /api/ooda/findings   latest Decide payload
#   GET  /api/ooda/cycles     last N cycle records
#   POST /api/ooda/trigger    fire a cycle now (60s cooldown)
#
# OFF by default. Set OODA_ENABLED=true ONLY after FLEET_URL + FLEET_API_TOKEN
# are set above; otherwise every cycle will fail the credential check.

OODA_ENABLED=false
# Cycle interval in seconds. 1800 = every 30 minutes.
OODA_INTERVAL_SEC=1800
# Run --full-scan every Nth cycle (refreshes per-team watermarks). 0 disables.
# Default: every 24th cycle ≈ once per 12h at the 30-min interval.
OODA_FULL_SCAN_EVERY=24
# Optional: comma-separated Fleet Team IDs. Leave unset for all teams.
# OODA_TEAMS=1,2

# Shadow IT detection — outlier threshold
# ---------------------------------------------------------------------------
# Software is considered Shadow IT when installed on no more than this
# fraction of a platform's hosts. Computed per-platform: a software on
# 1 of 10 Linux servers is treated differently than one on 1 of 100
# Windows hosts.
#
# Used by:
#   - /api/shadow-it (runtime detection in the dashboard)
#   - categorize_software.py (Wikidata enrichment candidate selection)
#
# Format: decimal fraction (0.03 = 3%). Range: 0 < pct < 1.
# Invalid values fall back to 0.03. Floor is always max(value, 2 hosts).
#
# Tuning notes:
#   0.03 (3%, default) — narrow Shadow IT focus, smaller candidate set
#   0.05 (5%, looser)  — wider net, more enrichment work, more false positives
#   0.01 (1%, tight)   — only the rarest software on each platform
SHADOW_IT_OUTLIER_PCT=0.03
